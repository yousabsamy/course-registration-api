NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (replace <db_password> and cluster host with your own)
DB_URL=mongodb+srv://<username>:<db_password>@cluster0.xxxxx.mongodb.net/course-registration?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=90d

# Ethereal/Mailtrap SMTP for testing password-reset emails in development
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your-mailtrap-username
EMAIL_PASSWORD=your-mailtrap-password
EMAIL_FROM=no-reply@course-registration.com
